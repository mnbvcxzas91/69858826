										if humanoidRootPart and humanoidRootPart:FindFirstChild("BodyVelocity") then
											local bodyVelocity = humanoidRootPart:FindFirstChild("BodyVelocity")
											bodyVelocity.Velocity = bodyVelocity.Velocity.Unit * f * 50
										end
									end
								end
							end)
						end
					end,
				})

