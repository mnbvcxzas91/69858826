					local colorSequence = ColorSequence.new
					local tbl8 = {}
					local v30 = ColorSequenceKeypoint.new(0, Color3.fromRGB(72, 36, 36))
					local v31 = ColorSequenceKeypoint.new(0.5, Color3.fromRGB(120, 62, 62))
