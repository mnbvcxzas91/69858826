					trail.Color = colorSequence(tbl8)
					local numberSequence2 = NumberSequence.new
					local tbl9 = {}
					local v32 = NumberSequenceKeypoint.new(0, 0.95)
					local v33 = NumberSequenceKeypoint.new(0.4, 0.7)
					local new3 = NumberSequenceKeypoint.new
